# Inkling-2-Mini on single NVIDIA DGX Spark (SGLang + DSpark, Tuned)
MODEL_ID=thinkingmachines/Inkling-2-Mini
HOST=0.0.0.0
PORT=8000
HF_CACHE_DIR=${HOME}/.cache/huggingface
HF_TOKEN=

SGLANG_IMAGE=lmsysorg/sglang:inkling-2-mini
SGLANG_MEM_FRACTION=0.45
SGLANG_PAGE_SIZE=16
SGLANG_CUDA_GRAPH_MAX_BS=8
SGLANG_NUM_DRAFT_TOKENS=8
SGLANG_ENABLE_MULTIMODAL=1
